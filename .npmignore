# Audio notification: build source (miniaudio.h + play_sound.c) not needed at runtime
extensions/aftc-toolset/bin/src/
# Audio notification: WAV originals (MP3s are the shipped format)
extensions/aftc-toolset/data/aftc-audio-notifications/*.wav
# Shipped defaults live under extensions/aftc-toolset/data/ (aftc-codex seed,
# aftc-audio-notifications MP3s, aftc-intro audio). The MP3s + codex seed ship;
# the maintainer dev tooling that processes the audio does NOT ship.
extensions/aftc-toolset/data/**/*.py
extensions/aftc-toolset/data/**/*.bat

# ── pi runtime data ──────────────────────────────────────
# Per-user caches and extension runtime data (user settings, SSH
# credentials, usage history). Created lazily from in-code defaults;
# NEVER ship any of it: ignore the whole directory, no negation rules.
# See AGENTS.md "Data directory, packaging, and test-exclusion
# decisions (permanent)".
.pi/
.pi-aftc-toolset/

